{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "all-aboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // NOTE: Local development only. Nothing here has been deployed, and the KV
  // id below is a placeholder that wrangler dev simulates locally.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameDO" },
      { "name": "PLAYERS", "class_name": "PlayerDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameDO", "PlayerDO"] }],
  "kv_namespaces": [{ "binding": "TOMBSTONES", "id": "local-tombstones" }],
  "vars": {
    "BOT_DELAY_MS": "1500",
  },
  "dev": {
    "port": 8790,
    "ip": "127.0.0.1",
  },
}
