{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "all-aboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // NOTE: Production, served at all-aboard.jonstuebe.com. Cloudflare's Git
  // integration (Workers Builds) deploys it on each push to main.
  "routes": [{ "pattern": "all-aboard.jonstuebe.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameDO" },
      { "name": "PLAYERS", "class_name": "PlayerDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameDO", "PlayerDO"] }],
  "kv_namespaces": [
    { "binding": "TOMBSTONES", "id": "e324e114562445fc882b65a91f21e4f3" },
  ],
  "vars": {
    "BOT_DELAY_MS": "1500",
  },
  "observability": { "enabled": true },
  "dev": {
    "port": 8790,
    "ip": "127.0.0.1",
  },
}
